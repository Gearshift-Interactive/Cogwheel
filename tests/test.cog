mut var arr = new int[]{ 7, 2, 9, 1, 5, 3, 8, 4 };
var maxArrayIndex = sizeof arr - 1u;
mut var i = 0u;
while (i < maxArrayIndex)
{
    mut var j = 0u;
    while (j < maxArrayIndex - i)
    {
        if (arr[j] > arr[j + 1u])
        {
            var temp = arr[j];
            arr[j] = arr[j + 1u];
            arr[j + 1u] = temp;
        };
        j = j + 1u;
    };
    i = i + 1u;
};
exit arr[0u] + arr[maxArrayIndex];
