mut var i = 0u;
var some = () -> {
    var result = (float)i / 2f == 0f;
    putChar(if (result) 't' else 'f');
    putChar('\n');
    i = i + 1u;
    yield result;
};
var test = some();
if (test and some())
    exit 1;
exit 0;
