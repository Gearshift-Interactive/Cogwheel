alias String = char[];

var print = (String str) -> {
    mut var i = 0u;
    while (i < sizeof str)
    {
        putChar(str[i]);
        i = i + 1u;
    };
};
var println = (String... strs) -> {
    mut var i = 0u;
    while (i < sizeof strs)
    {
        print(strs[i]);
        i = i + 1u;
    };
    putChar('\n');
};
var printlns = (String... strs) -> {
    mut var i = 0u;
    while (i < sizeof strs)
    {
        print(strs[i]);
        putChar('\n');
        i = i + 1u;
    };
};
println("Hello, ", $false);
