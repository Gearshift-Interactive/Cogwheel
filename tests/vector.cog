alias String = char[];

var print = (String... strs) -> {
    mut var j = 0u;
    while (j < sizeof strs)
    {
        var str = strs[j];
        mut var i = 0u;
        while (i < sizeof str)
        {
            putChar(str[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
};
var println = (String... strs) -> {
    mut var i = 0u;
    while (i < sizeof strs)
    {
        print(strs[i]);
        i = i + 1u;
    };
    putChar('\n');
};

var panic = (String... message) -> {
    print("[PANIC] ");
    mut var i = 0u;
    while (i < sizeof message)
    {
        print(message[i]);
        i = i + 1u;
    };
    putChar('\n');
    exit 1;
};

alias Vector = float[];
alias VectorAction = float(float, float);

var Vector2d = (float x, float y) -> new [x, y];
var Vector3d = (float x, float y, float z) -> new [x, y, z];
var Vector4d = (float x, float y, float z, float w) -> new [x, y, z, w];
var Vector_elementwise = (VectorAction action) -> (Vector a, Vector... other) -> {
    mut var result = new [sizeof a; 0f];
    result[0u] = a[0u];
    result[1u] = a[1u];
    mut var j = 0u;
    if (sizeof other < 1u)
        panic("Elementwise operation on a single vector");
    while (j < sizeof other)
    {
        var current = other[j];
        if (sizeof a != sizeof current)
            panic("Elementwise operation on differently sized vectors");
        mut var i = 0u;
        while (i < sizeof a)
        {
            result[i] = action(result[i], current[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
    yield result;
};
var Vector_add = Vector_elementwise((float a, float b) -> a + b);
var Vector_sub = Vector_elementwise((float a, float b) -> a - b);
var Vector_mul = Vector_elementwise((float a, float b) -> a * b);
var Vector_div = Vector_elementwise((float a, float b) -> a / b);
var Vector_toString = (Vector this) -> {
    mut var result = "Vector" + $sizeof this + "d(";
    mut var i = 0u;
    while (i < sizeof this)
    {
        result = result + $this[i] +
            if (i == sizeof this - 1u)
                ")"
            else
                ", ";
        i = i + 1u;
    };
    yield result;
};

var vector1 = Vector2d(1.0, 0.5);
var vector2 = Vector3d(0.5, 1.0,  0.75);
var vector3 = Vector3d(1.0, 0.25, 0.75);
var vector4 = Vector_add(vector2, vector3, vector3);
var vector5 = Vector2d(vector4[0u], vector4[1u]);
var vector6 = Vector_add(vector1, vector5);

var round = (float i) -> if(i >= 0.5) (int)i + 1 else (int)i;

println("1 - ", Vector_toString(vector1));
println("2 - ", Vector_toString(vector2));
println("3 - ", Vector_toString(vector3));
println("4 - ", Vector_toString(vector4));
println("5 - ", Vector_toString(vector5));
println("6 - ", Vector_toString(vector6));
