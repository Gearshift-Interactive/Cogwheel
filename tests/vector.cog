var Vector2d = (float x, float y) -> new [x, y];
var Vector3d = (float x, float y, float z) -> new [x, y, z];
var Vector4d = (float x, float y, float z, float w) -> new [x, y, z, w];
var Vector_elenentwise = (float(float, float) action) -> (float[] a, float[]... other) -> {
    mut var result = new [sizeof a; 0f];
    result[0u] = a[0u];
    result[1u] = a[1u];
    mut var j = 0u;
    if (sizeof other < 1u)
        exit 1;
    while (j < sizeof other)
    {
        var current = other[j];
        if (sizeof a != sizeof current)
            exit 1;
        mut var i = 0u;
        while (i < sizeof a)
        {
            result[i] = action(result[i], current[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
    yield result;
};
var Vector_add = Vector_elenentwise((float a, float b) -> a + b);
var Vector_sub = Vector_elenentwise((float a, float b) -> a - b);
var Vector_mul = Vector_elenentwise((float a, float b) -> a * b);
var Vector_div = Vector_elenentwise((float a, float b) -> a / b);

var vector1 = Vector2d(1.0, 0.5);
var vector2 = Vector3d(0.5, 1.0,  0.75);
var vector3 = Vector3d(1.0, 0.25, 0.75);
var vector4 = Vector_add(vector2, vector3, vector3);
var vector5 = Vector2d(vector4[0u], vector4[1u]);
var vector6 = Vector_add(vector1, vector5);

var round = (float i) -> if(i >= 0.5) (int)i + 1 else (int)i;

exit round(vector6[0u]);

