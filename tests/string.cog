alias String = char[];

public var print = (String... strs) -> {
    mut var j = 0u;
    while (j < sizeof strs)
    {
        var str = strs[j];
        mut var i = 0u;
        while (i < sizeof str)
        {
            putChar(str[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
};
public var println = (String... strs) -> {
    mut var i = 0u;
    while (i < sizeof strs)
    {
        print(strs[i]);
        i = i + 1u;
    };
    putChar('\n');
};

println("fromStrieng");
