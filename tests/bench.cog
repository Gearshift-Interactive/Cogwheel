alias String = char[];

public var print = (strs: String...) -> {
    mut var j = 0u;
    while (j < #strs)
    {
        var str = strs[j];
        mut var i = 0u;
        while (i < #str)
        {
            putChar(str[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
};
public var println = (strs: String...) -> {
    mut var i = 0u;
    while (i < #strs)
    {
        print(strs[i]);
        i = i + 1u;
    };
    putChar('\n');
};

var ITERATIONS = 10000000;
mut var sum = 0;
mut var i = 0;
mut var value = 0;

while (i < ITERATIONS)
{
    sum = sum + value;

    value = value + 1;
    if (value == 100)
        value = 0;

    i = i + 1;
};

println("Arithmetic checksum: ", $sum);
