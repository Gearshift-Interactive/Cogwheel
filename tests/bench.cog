alias String = char[];

public var print = (String... strs) -> {
    mut var j = 0u;
    while (j < sizeof strs)
    {
        var str = strs[j];
        mut var i = 0u;
        while (i < sizeof str)
        {
            putChar(str[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
};
public var println = (String... strs) -> {
    mut var i = 0u;
    while (i < sizeof strs)
    {
        print(strs[i]);
        i = i + 1u;
    };
    putChar('\n');
};

int ITERATIONS = 10000000;
mut int sum = 0;
mut int i = 0;
mut int value = 0;

while (i < ITERATIONS)
{
    sum = sum + value;

    value = value + 1;
    if (value == 100)
        value = 0;

    i = i + 1;
};

println("Arithmetic checksum: ", $sum);
