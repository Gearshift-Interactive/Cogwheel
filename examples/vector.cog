import util;

alias Vector = float[];
alias VectorAction = float(float, float);

var Vector2d = (x: float, y: float) -> new [x, y];
var Vector3d = (x: float, y: float, z: float) -> new [x, y, z];
var Vector4d = (x: float, y: float, z: float, w: float) -> new [x, y, z, w];
var Vector_elementwise = (action: VectorAction ) -> (a: Vector, other: Vector...) -> {
    mut var result = new [#a; 0f];
    result[0u] = a[0u];
    result[1u] = a[1u];
    mut var j = 0u;
    if (#other < 1u)
        util::panic("Elementwise operation on a single vector");
    while (j < #other)
    {
        var current = other[j];
        if (#a != #current)
            util::panic("Elementwise operation on differently sized vectors");
        mut var i = 0u;
        while (i < #a)
        {
            result[i] = action(result[i], current[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
    yield result;
};
var Vector_add = Vector_elementwise((a: float, b: float) -> a + b);
var Vector_sub = Vector_elementwise((a: float, b: float) -> a - b);
var Vector_mul = Vector_elementwise((a: float, b: float) -> a * b);
var Vector_div = Vector_elementwise((a: float, b: float) -> a / b);
var Vector_toString = (this: Vector) -> {
    mut var result = "Vector" + $#this + "d(";
    mut var i = 0u;
    while (i < #this)
    {
        result = result + $this[i] +
            if (i == #this - 1u)
                ")"
            else
                ", ";
        i = i + 1u;
    };
    yield result;
};

var vector1 = Vector2d(1.0, 0.5);
var vector2 = Vector3d(0.5, 1.0,  0.75);
var vector3 = Vector3d(1.0, 0.25, 0.75);
var vector4 = Vector_add(vector2, vector3, vector3);
var vector5 = Vector2d(vector4[0u], vector4[1u]);
var vector6 = Vector_add(vector1, vector5);

var round = (i: float) -> if(i >= 0.5) (int)i + 1 else (int)i;

util::println("1 - ", Vector_toString(vector1));
util::println("2 - ", Vector_toString(vector2));
util::println("3 - ", Vector_toString(vector3));
util::println("4 - ", Vector_toString(vector4));
util::println("5 - ", Vector_toString(vector5));
util::println("6 - ", Vector_toString(vector6));
