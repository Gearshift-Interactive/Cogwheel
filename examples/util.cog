alias String = char[];

public var print = (strs: String...) -> {
    mut var j = 0u;
    while (j < #strs)
    {
        var str = strs[j];
        mut var i = 0u;
        while (i < #str)
        {
            putChar(str[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
};
public var println = (strs: String...) -> {
    mut var i = 0u;
    while (i < #strs)
    {
        print(strs[i]);
        i = i + 1u;
    };
    putChar('\n');
};
public var panic = (message: String...) -> {
    print("[PANIC] ");
    mut var i = 0u;
    while (i < #message)
    {
        print(message[i]);
        i = i + 1u;
    };
    putChar('\n');
    exit 1;
};
