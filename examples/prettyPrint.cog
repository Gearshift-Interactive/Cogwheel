alias String = char[];

var print = (String... strs) -> {
    mut var j = 0u;
    while (j < sizeof strs)
    {
        var str = strs[j];
        mut var i = 0u;
        while (i < sizeof str)
        {
            putChar(str[i]);
            i = i + 1u;
        };
        j = j + 1u;
    };
};
var println = (String... strs) -> {
    mut var i = 0u;
    while (i < sizeof strs)
    {
        print(strs[i]);
        i = i + 1u;
    };
    putChar('\n');
};
var arrayPrettyPrint = (int?[] array) -> {
    println("[");
    mut var i = 0u;
    while (i < sizeof array)
    {
        print("  ", $array[i]!,
            if (i == sizeof array - 1u)
                "\n"
            else
                ",\n"
        );
        i = i + 1u;
    };
    println("]");
};
var arrayPrettyString = (int?[] array) -> {
    mut var result = "";
    result = result + "[\n";
    mut var i = 0u;
    while (i < sizeof array)
    {
        result = result + "  " + $array[i]! +
            if (i == sizeof array - 1u)
                "\n"
            else
                ",\n";
        i = i + 1u;
    };
    result = result + "]\n";
    yield result;
};
var array = new [ 12, 43, 65, 745, 43 ];
arrayPrettyPrint(array);
print(arrayPrettyString(array));
