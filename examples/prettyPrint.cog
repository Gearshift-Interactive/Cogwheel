import util;

var arrayPrettyPrint = (array: int?[]) -> {
    util::println("[");
    mut var i = 0u;
    while (i < #array)
    {
        util::print("  ", $array[i]!,
            if (i == #array - 1u)
                "\n"
            else
                ",\n"
        );
        i = i + 1u;
    };
    util::println("]");
};
var arrayPrettyString = (array: int?[]) -> {
    mut var result = "";
    result = result + "[\n";
    mut var i = 0u;
    while (i < #array)
    {
        result = result + "  " + $array[i]! +
            if (i == #array - 1u)
                "\n"
            else
                ",\n";
        i = i + 1u;
    };
    result = result + "]\n";
    yield result;
};
var array = new [ 12, 43, 65, 745, 43 ];
arrayPrettyPrint(array);
util::print(arrayPrettyString(array));
